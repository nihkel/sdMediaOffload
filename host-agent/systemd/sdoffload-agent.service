[Unit]
Description=SD Media Offload host agent (HTTP control listener for LXC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/sdoffload-agent
ExecStart=/usr/local/bin/sdoffload-agent serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
