# Copy to .env and adjust. Read by docker compose.

# Shared secret between host-agent (Proxmox host) and the backend.
# Generate with: openssl rand -hex 32
SDOFFLOAD_HOST_TOKEN=change-me-please

# Public port for the web UI + API
SDOFFLOAD_PORT=8000

# Where imported files end up. On Proxmox, point this at your NAS dataset
# (e.g. /mnt/pve/photos or an NFS mount).
SDOFFLOAD_DESTINATION_PATH=./media

# Where the host-agent mounts incoming devices, as seen by THIS container.
# On Proxmox: NFS-mount the host's /mnt/sdoffload here, or use virtiofs.
SDOFFLOAD_SOURCE_PATH=./mock-source

# Persistent app data (SQLite db + caches)
SDOFFLOAD_DATA_PATH=./data

# Optional path remap if host's mount path differs from container's mount path.
# Format: "<host-prefix>:<container-prefix>"
# Leave empty if both sides see the same path.
SDOFFLOAD_SOURCE_PATH_REMAP=

# Default destination template for files (camera profiles can override).
SDOFFLOAD_DEFAULT_TEMPLATE={camera_slug}/{captured:%Y}/{captured:%Y-%m-%d}/{original_name}

SDOFFLOAD_LOG_LEVEL=INFO
